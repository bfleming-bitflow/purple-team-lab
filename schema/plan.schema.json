{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bfleming-bitflow/purple-team-lab/schema/plan.schema.json",
  "title": "Adversary emulation plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "title",
    "technique",
    "tactic",
    "platforms",
    "authorization_required",
    "preconditions",
    "procedure",
    "telemetry",
    "detection_strategies",
    "detections",
    "mitigations",
    "hardening",
    "cleanup",
    "references"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^PTL-[0-9]{3}$",
      "description": "Stable plan identifier."
    },
    "title": {
      "type": "string",
      "minLength": 10,
      "maxLength": 120
    },
    "technique": {
      "type": "string",
      "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$",
      "description": "Primary Enterprise ATT&CK technique."
    },
    "additional_techniques": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
      }
    },
    "tactic": {
      "type": "string",
      "description": "ATT&CK tactic shortname, validated against the vendored tactic list."
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "Windows",
          "Linux",
          "macOS"
        ]
      }
    },
    "authorization_required": {
      "const": true,
      "description": "Every plan must assert that execution requires written authorization."
    },
    "atomic_tests": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
      },
      "description": "Atomic Red Team GUIDs for the equivalent public tests, when they exist."
    },
    "preconditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "procedure": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/step"
      }
    },
    "telemetry": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/telemetry_source"
      }
    },
    "detection_strategies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^DET[0-9]{4}$"
      },
      "description": "ATT&CK detection strategies that cover the plan's techniques."
    },
    "detections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/detection"
      }
    },
    "mitigations": {
      "type": "array",
      "minItems": 0,
      "items": {
        "$ref": "#/$defs/mitigation"
      },
      "description": "ATT&CK mitigations mapped to the technique (or its parent). Empty only when ATT&CK maps none."
    },
    "hardening": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 10
      },
      "description": "Concrete configuration changes for the lab and production estate."
    },
    "cleanup": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "references": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/reference"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "description",
        "command"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 3
        },
        "description": {
          "type": "string",
          "minLength": 10
        },
        "command": {
          "type": "string",
          "minLength": 3
        },
        "shell": {
          "enum": [
            "cmd",
            "powershell",
            "bash"
          ]
        },
        "elevation_required": {
          "type": "boolean"
        }
      }
    },
    "telemetry_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "event_id",
        "data_component",
        "signal"
      ],
      "properties": {
        "source": {
          "type": "string",
          "description": "Log source name as used in data/windows-events.yml (Sysmon, Security, PowerShell)."
        },
        "event_id": {
          "type": "integer",
          "minimum": 1,
          "description": "Event ID, validated against data/windows-events.yml."
        },
        "data_component": {
          "type": "string",
          "pattern": "^DC[0-9]{4}$",
          "description": "ATT&CK data component ID, validated against the vendored list."
        },
        "signal": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "path",
        "techniques",
        "coverage"
      ],
      "properties": {
        "repository": {
          "enum": [
            "detection-rules"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^rules/(yara|sigma)/[A-Za-z0-9_./-]+\\.(yar|yml)$"
        },
        "techniques": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^T[0-9]{4}(\\.[0-9]{3})?$"
          }
        },
        "coverage": {
          "enum": [
            "expected-match",
            "partial",
            "gap"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "mitigation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "description"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^M[0-9]{4}$",
          "description": "ATT&CK mitigation ID, validated against the vendored list."
        },
        "name": {
          "type": "string",
          "minLength": 3
        },
        "description": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "publisher",
        "url"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 3
        },
        "publisher": {
          "type": "string",
          "minLength": 2
        },
        "url": {
          "type": "string",
          "pattern": "^https://"
        }
      }
    }
  }
}
